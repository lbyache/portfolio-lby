---
import GitHub from "./icons/GitHub.astro"
import AstroIcon from "./icons/AstroIcon.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import HTML from "./icons/HTML.astro"
import LinkButton from "./LinkButton.astro"
import Laravel from "./icons/Laravel.astro"
import Bootstrap from "./icons/Bootstrap.astro"

const TAGS = {
  ASTRO: {
    name: "Astro",
    class: "bg-purple-600 text-white",
    icon: AstroIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },  
  HTML: {
    name: "HTML",
    class: "bg-[#fc694d] text-white",
    icon: HTML,
  },
  LARAVEL: {
    name: "Laravel",
    class: "bg-white text-[#ff0000]",
    icon: Laravel,
  },
  BOOTSTRAP: {
    name: "Bootstrap",
    class: "bg-white text-[#7952b3]",
    icon: Bootstrap,
  },
}

const PROJECTS = [
{
    title: "LumeFresh Shop",
    description:
      "Desarrollé un tienda online utilizando HTML, CSS, JS vanilla con web components, MongoDB como base de datos y pasarela de pago con MercadoPago. Incluye politicas de privacidad con gestion de cookies conforme normativa GDPR, promociones, catálogo de productos, una sección de contacto adaptada para dispositivos móviles y test de tipo de piel para ayudar a los clientes a elegir su producto ideal.",
    link: "https://lumefresh.shop/",  
    image: "/lume.png",
    tags: [ TAGS.HTML],
  },
  {
    title: "Farmacia Colón",
    description:
      "Proyecto educativo utilizando utilizando HTML, Tailwind y Laravel. Incluye promociones, catálogo de productos y una sección de contacto adaptada para dispositivos móviles.",
    github: "https://github.com/yachela/web-fcia-colon", 
    image: "/fciacolon.webp",
    tags: [ TAGS.LARAVEL],
  },
  {
    title: "Himnos de Gloria",
    description:
      "Landing page promocional para la app mobile Himnos de Gloria, incluye formulario de contacto.",
    link: "https://himnariodegloria.web.app/", 
    image: "/himnos.webp",
    tags: [ TAGS.HTML, TAGS.BOOTSTRAP],
  },
  {
    title: "SintheSky",
    description:
      "Landing page desarrollado con Astro y Tailwind CSS para mostrar productos de cerámica hechos a mano. Incluye un diseño minimalista y moderno.",
    link: "https://sinthesky.vercel.app/", 
    github: "https://github.com/LauYache/sinthesky-web", 
    image: "/sinthesky.webp",
    tags: [ TAGS.ASTRO, TAGS.TAILWIND],
  },

]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
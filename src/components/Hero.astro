---
const personalImageAlt = "Laura Yachelini";
import PdfCV from "@/components/icons/Pdf.astro";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import PdfIcon from "@/components/icons/Pdf.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-20"
      src="/foto.webp"
      alt={personalImageAlt}
    />
    <a
      href="https:/linkedin.com/in/lauyache"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge class="bg-accent text-white">Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hola, soy Laura Yachelini
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-accent-light [&>strong]:text-accent [&>strong]:font-semibold dark:text-gray-300"
  >
    Desarrolladora Web Freelance, <strong>Docente y Emprendedora</strong> de Buenos Aires, Argentina 🇦🇷. Me especializo en crear soluciones web y móviles que se destacan por su funcionalidad y diseño.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:lbyachelini@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https:/linkedin.com/in/lauyache">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="/laura-yachelini-cv.pdf"  download = "Laura Yachelini CV">
      <PdfIcon class="size-4" />
      Descargar CV
    </SocialPill>
  </nav>
</div>